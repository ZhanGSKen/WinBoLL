<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许特定域名的HTTP明文请求（如winboll.com） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">winboll.cc</domain> <!-- 你的目标域名 -->
        <domain includeSubdomains="true">www.winboll.cc</domain> <!-- 其他需要兼容的域名 -->
    </domain-config>
    <!-- 内网 (studio.winboll) 专用：信任随包分发的 WinBoLL Studio 根 CA，用户无需手动安装 -->
    <domain-config>
        <domain includeSubdomains="true">studio.winboll</domain>
        <trust-anchors>
            <certificates src="@raw/winboll_studio_root_ca" />
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>

    <!-- 全局允许HTTP明文请求（支持网站HTTP协议访问） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- 信任用户手动安装的证书（如 WinBoLL 根 CA，由用户在系统设置中安装，可随时卸载） -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- 允许特定域名的明文请求（仅本地127.0.0.1） -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>


