<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<cc.winboll.studio.libaes.views.ASupportToolbar
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:id="@+id/toolbar"/>

	<!-- The whole settings body scrolls: tall sections (cert install,
	     hosted playback radio group) must never be clipped on small screens. -->
	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true"
		android:scrollbars="vertical">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical">

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:paddingTop="16dp"
		android:paddingBottom="8dp"
		android:text="@string/settings_section_security"
		android:textStyle="bold"
		android:textSize="16sp"/>

	<Button
		android:id="@+id/btn_install_cert"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginLeft="12dp"
		android:layout_marginRight="12dp"
		android:text="@string/settings_install_cert"
		android:textSize="16sp"
		android:padding="12dp"/>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:paddingTop="8dp"
		android:text="@string/settings_install_cert_desc"
		android:textSize="13sp"/>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:paddingTop="24dp"
		android:paddingBottom="8dp"
		android:text="@string/settings_section_browser_home"
		android:textStyle="bold"
		android:textSize="16sp"/>

	<EditText
		android:id="@+id/et_home_url"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginLeft="12dp"
		android:layout_marginRight="12dp"
		android:inputType="textUri"
		android:singleLine="true"
		android:hint="@string/settings_browser_home_hint"
		android:textSize="15sp"/>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:paddingLeft="12dp"
		android:paddingRight="12dp"
		android:paddingTop="8dp">

		<Button
			android:id="@+id/btn_save_home_url"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/settings_browser_home_save"
			android:textSize="16sp"/>

		<Button
			android:id="@+id/btn_reset_home_url"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginLeft="8dp"
			android:text="@string/settings_browser_home_reset"
			android:textSize="16sp"/>

	</LinearLayout>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:paddingTop="8dp"
		android:text="@string/settings_browser_home_desc"
		android:textSize="13sp"/>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:paddingTop="24dp"
		android:paddingBottom="8dp"
		android:text="@string/settings_section_hosted_playback"
		android:textStyle="bold"
		android:textSize="16sp"/>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:paddingTop="4dp">

		<TextView
			android:id="@+id/tv_hosted_playback_label"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/settings_hosted_playback_label"
			android:textSize="16sp"/>

		<Switch
			android:id="@+id/switch_hosted_playback"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"/>

	</LinearLayout>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:paddingTop="8dp"
		android:text="@string/settings_hosted_playback_desc"
		android:textSize="13sp"/>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:paddingTop="16dp"
		android:text="@string/settings_hosted_playback_model_label"
		android:textStyle="bold"
		android:textSize="16sp"/>

	<RadioGroup
		android:id="@+id/rg_hosted_playback_model"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingLeft="8dp"
		android:paddingRight="16dp"
		android:paddingTop="4dp">

		<RadioButton
			android:id="@+id/rb_model_classic"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/settings_hosted_playback_model_classic"
			android:textSize="16sp"/>

		<RadioButton
			android:id="@+id/rb_model_enhanced"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/settings_hosted_playback_model_enhanced"
			android:textSize="16sp"/>

		<RadioButton
			android:id="@+id/rb_model_dynamic"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/settings_hosted_playback_model_dynamic"
			android:textSize="16sp"/>

	</RadioGroup>

	<!-- Model 1 parameters: collapsible, collapsed by default. -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">

		<LinearLayout
			android:id="@+id/ll_hosted_playback_classic_header"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="?android:attr/selectableItemBackground"
			android:clickable="true"
			android:focusable="true"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingLeft="32dp"
			android:paddingRight="16dp"
			android:paddingTop="12dp"
			android:paddingBottom="8dp">

			<TextView
				android:id="@+id/tv_hosted_playback_classic_label"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/settings_hosted_playback_classic_label"
				android:textSize="14sp"
				android:textStyle="bold"/>

			<TextView
				android:id="@+id/tv_hosted_playback_classic_arrow"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="▸"
				android:textSize="14sp"/>
		</LinearLayout>

		<LinearLayout
			android:id="@+id/ll_hosted_playback_classic_body"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:visibility="gone">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="32dp"
				android:paddingRight="16dp"
				android:paddingBottom="8dp"
				android:text="@string/settings_classic_desc"
				android:textSize="13sp"/>

			<Button
				android:id="@+id/btn_reset_classic"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="end"
				android:layout_marginRight="16dp"
				android:layout_marginBottom="8dp"
				android:text="@string/settings_reset_classic"
				android:textSize="13sp"/>
		</LinearLayout>
	</LinearLayout>

	<!-- Model 2 parameters: collapsible, collapsed by default. -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">

		<LinearLayout
			android:id="@+id/ll_hosted_playback_gain_header"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="?android:attr/selectableItemBackground"
			android:clickable="true"
			android:focusable="true"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingLeft="32dp"
			android:paddingRight="16dp"
			android:paddingTop="12dp"
			android:paddingBottom="8dp">

			<TextView
				android:id="@+id/tv_hosted_playback_gain_label"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/settings_hosted_playback_gain_label"
				android:textSize="14sp"
				android:textStyle="bold"/>

			<TextView
				android:id="@+id/tv_hosted_playback_gain_arrow"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="▸"
				android:textSize="14sp"/>
		</LinearLayout>

		<LinearLayout
			android:id="@+id/ll_hosted_playback_gain_body"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:visibility="gone">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingLeft="32dp"
				android:paddingRight="16dp"
				android:paddingTop="4dp">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/settings_gain_label"
					android:textSize="14sp"/>

				<TextView
					android:id="@+id/tv_gain_value"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="14sp"/>
			</LinearLayout>

			<SeekBar
				android:id="@+id/sb_gain"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"/>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="32dp"
				android:paddingRight="16dp"
				android:paddingTop="4dp"
				android:text="@string/settings_hosted_playback_gain_desc"
				android:textSize="13sp"/>

			<Button
				android:id="@+id/btn_reset_gain"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="end"
				android:layout_marginRight="16dp"
				android:layout_marginBottom="8dp"
				android:text="@string/settings_reset_gain"
				android:textSize="13sp"/>
		</LinearLayout>
	</LinearLayout>

	<!-- Model 3 parameters: collapsible, collapsed by default. -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical">

		<LinearLayout
			android:id="@+id/ll_hosted_playback_dynamic_header"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="?android:attr/selectableItemBackground"
			android:clickable="true"
			android:focusable="true"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingLeft="32dp"
			android:paddingRight="16dp"
			android:paddingTop="12dp"
			android:paddingBottom="8dp">

			<TextView
				android:id="@+id/tv_hosted_playback_dynamic_label"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/settings_hosted_playback_dynamic_label"
				android:textSize="14sp"
				android:textStyle="bold"/>

			<TextView
				android:id="@+id/tv_hosted_playback_dynamic_arrow"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="▸"
				android:textSize="14sp"/>
		</LinearLayout>

		<LinearLayout
			android:id="@+id/ll_hosted_playback_dynamic_body"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:visibility="gone">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingLeft="32dp"
				android:paddingRight="16dp"
				android:paddingTop="8dp">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/settings_dynamic_gain_label"
					android:textSize="14sp"/>

				<TextView
					android:id="@+id/tv_dyn_gain_value"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="14sp"/>
			</LinearLayout>

			<SeekBar
				android:id="@+id/sb_dyn_gain"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"/>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingLeft="32dp"
				android:paddingRight="16dp"
				android:paddingTop="8dp">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/settings_dynamic_comp_label"
					android:textSize="14sp"/>

				<TextView
					android:id="@+id/tv_dyn_comp_value"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="14sp"/>
			</LinearLayout>

			<SeekBar
				android:id="@+id/sb_dyn_comp"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"/>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingLeft="32dp"
				android:paddingRight="16dp"
				android:paddingTop="8dp">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/settings_dynamic_ratio_label"
					android:textSize="14sp"/>

				<TextView
					android:id="@+id/tv_dyn_ratio_value"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="14sp"/>
			</LinearLayout>

			<SeekBar
				android:id="@+id/sb_dyn_ratio"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"/>

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal"
				android:paddingLeft="32dp"
				android:paddingRight="16dp"
				android:paddingTop="8dp">

				<TextView
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/settings_dynamic_limit_label"
					android:textSize="14sp"/>

				<TextView
					android:id="@+id/tv_dyn_limit_value"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:textSize="14sp"/>
			</LinearLayout>

			<SeekBar
				android:id="@+id/sb_dyn_limit"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="16dp"
				android:paddingRight="16dp"/>

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingLeft="32dp"
				android:paddingRight="16dp"
				android:paddingTop="4dp"
				android:text="@string/settings_dynamic_desc"
				android:textSize="13sp"/>

			<Button
				android:id="@+id/btn_reset_dynamic"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="end"
				android:layout_marginRight="16dp"
				android:layout_marginBottom="8dp"
				android:text="@string/settings_reset_dynamic"
				android:textSize="13sp"/>
		</LinearLayout>
	</LinearLayout>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingLeft="16dp"
		android:paddingRight="16dp"
		android:paddingTop="8dp"
		android:paddingBottom="16dp"
		android:text="@string/settings_hosted_playback_model_desc"
		android:textSize="13sp"/>

		</LinearLayout>

	</ScrollView>

</LinearLayout>
