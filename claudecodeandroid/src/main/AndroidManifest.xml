<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cc.winboll.studio.claudecodeandroid">

    <!-- 访问局域网桥接服务 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@android:style/Theme.Material.Light"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <activity
            android:name="cc.winboll.studio.claudecodeandroid.ui.MainActivity"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="cc.winboll.studio.claudecodeandroid.ui.ChatActivity"
            android:label="@string/title_chat"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="cc.winboll.studio.claudecodeandroid.ui.SettingsActivity"
            android:label="@string/title_settings"
            android:exported="false" />
    </application>

</manifest>
