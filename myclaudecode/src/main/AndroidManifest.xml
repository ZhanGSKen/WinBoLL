<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="cc.winboll.studio.myccconnector">

    <!-- 访问局域网桥接服务 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/AESTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <activity
            android:name="cc.winboll.studio.myccconnector.ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="cc.winboll.studio.myccconnector.ui.ChatActivity"
            android:label="@string/title_chat"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="cc.winboll.studio.myccconnector.ui.SettingsActivity"
            android:label="@string/title_settings"
            android:exported="false" />

        <activity
            android:name="cc.winboll.studio.myccconnector.ui.AboutActivity"
            android:label="@string/title_about"
            android:exported="false" />

        <activity
            android:name="cc.winboll.studio.myccconnector.ui.OpenSourceLicenseActivity"
            android:label="@string/title_open_source"
            android:exported="false" />

        <!-- 安全覆盖：libappbase 注入的两个日志组件默认对外导出且无权限保护，
             会让任意应用拉起并读取/分享本应用日志，这里收回为应用内可见。 -->
        <activity
            android:name="cc.winboll.studio.libappbase.LogActivity"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name="cc.winboll.studio.libappbase.utils.ShareLogActivity"
            android:exported="false"
            tools:replace="android:exported" />

        <!-- 清理：libaes 注入的单元测试 Activity 不应进入正式包。 -->
        <activity android:name="cc.winboll.studio.libaes.unittests.SecondaryLibraryActivity"
            tools:node="remove" />
        <activity android:name="cc.winboll.studio.libaes.unittests.TestDrawerFragmentActivity"
            tools:node="remove" />
        <activity android:name="cc.winboll.studio.libaes.unittests.TestAToolbarActivity"
            tools:node="remove" />
        <activity android:name="cc.winboll.studio.libaes.unittests.TestASupportToolbarActivity"
            tools:node="remove" />
    </application>

</manifest>
